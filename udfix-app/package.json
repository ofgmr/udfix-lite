    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "electron": "^39.2.3",
    "electron-builder": "^22.14.13",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "knip": "^5.88.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.3"
  },
  "depcheck": {
    "ignoreMissing": [
      "flowbite",
      "flowbite-typography",
      "vitest"
    ],
    "ignorePatterns": [
      "_probe",
      "dist",
      "dist-electron",
      "release",
      ".repo-health",
      "scripts/.cache"
    ],
    "ignoreMatches": [
      "@fontsource/*",
      "material-symbols",
      "@tailwindcss/postcss",
      "tailwindcss-animate",
      "postcss",
      "tailwindcss",
      "cross-env",
      "depcheck",
      "knip"
    ],
    "ignoreBinPackage": true,
    "specials": [
      "bin",
      "eslint",
      "vite",
      "webpack",
      "prettier",
      "jest",
      "babel"
    ]
  },
  "build": {
    "appId": "com.ofg.udfix",
    "productName": "UDFIX",
    "fileAssociations": [
      {
        "ext": "udf",
        "name": "UYAP UDF Belgesi",
        "description": "UYAP Doküman Formatı (UDF)",
        "role": "Editor",
        "rank": "Owner",
        "icon": "udf.icns",
        "mimeType": "application/x-uyap-udf"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "branding.manifest.json",
      "!**/node_modules/@fontsource/**",
      "!**/node_modules/material-symbols/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/branding/udfix-app-icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "CFBundleDisplayName": "UDFIX",
        "CFBundleName": "UDFIX",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "UDFIX",
            "CFBundleURLSchemes": [
              "udfix"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.ofg.udfix.udf",
            "UTTypeDescription": "UYAP UDF Belgesi",
            "UTTypeConformsTo": [
              "public.data",
              "public.content",
              "public.xml"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "udf"
              ],
              "public.mime-type": [
                "application/x-uyap-udf"
              ]
            },
            "UTTypeIconFiles": [
              "udf.icns"
            ]
          }
        ]
      }
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "extraMetadata": {
      "udfixEdition": "lite"
    },
    "extraResources": [],
    "publish": [
      {
        "provider": "generic",
        "url": "https://releases.udfix.com/lite/macos/"
      }
    ],
    "win": {
      "icon": "public/branding/udfix-app-icon.png"
    }
  }
}
