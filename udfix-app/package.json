{
  "name": "udfix-app",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0 WITH Commons-Clause",
  "productName": "UDFIX",
  "author": "OFG",
  "description": "UDFIX — yerel öncelikli hukuk kelime işlemci ve bilgi yönetim sistemi",
  "homepage": "https://udfix.app",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n vite,electron \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p electron/tsconfig.json && node scripts/copy-electron-assets.mjs && cross-env NODE_ENV=development electron .",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json && node scripts/copy-electron-assets.mjs && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "npx patch-package && node scripts/copy-pdfjs-assets.mjs && npx @electron/rebuild -f -w better-sqlite3",
    "copy:pdfjs-assets": "node scripts/copy-pdfjs-assets.mjs",
    "rebuild:sqlite": "npx @electron/rebuild -f -w better-sqlite3"
  },
